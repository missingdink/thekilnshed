    "read-cache": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.1"
