<a href="<%= @permalink %>" target="_blank" rel="noopener" class="relative block">
  <div class="hover:bg-coal-1000/88 w-full h-full text-coal-0 z-10 opacity-0 hover:opacity-100 absolute transition-all duration-400 ease-in-out flex flex-col gap-3 items-start justify-end p-8">
    <% if @posted_at %>
      <p class="font-bold !text-xl"><%= @posted_at.strftime("%B %-d, %Y") %></p>
    <% end %>
    <p class="line-clamp-5"><%= @caption %></p>
  </div>
  <img src="<%= @image_src %>" alt="<%= @caption.to_s.truncate(120) %>" loading="lazy" class="w-full h-full max-h-[400px] object-cover hover:blur-md" />
</a>
