<article class="flex flex-col">
  <%= render Shared::ReviewFlag.new(item: @artist) %>
  <% if @featured %>
    <img src="<%= relative_url @featured["image"] %>" alt="<%= alt_for(@featured) %>" class="w-full aspect-square object-cover bg-brown-100" />
  <% end %>
  <% if @samples.any? %>
    <div class="grid grid-cols-2 gap-1 mt-1">
      <% @samples.each do |work| %>
        <img src="<%= relative_url work["image"] %>" alt="<%= alt_for(work) %>" class="w-full aspect-square object-cover bg-brown-100" />
      <% end %>
    </div>
  <% end %>
  <div class="bg-coal-0 text-indigo-600 p-8 flex-1">
    <h4><%= @artist["name"] %></h4>
    <% if @artist["studio"].present? %>
      <h6 class="mb-6 !font-normal text-indigo-800"><%= @artist["studio"] %></h6>
    <% end %>
    <% if links.any? %>
      <div class="flex flex-col md:flex-row flex-wrap gap-x-6 gap-y-3 mb-6">
        <% links.each do |label, url, icon| %>
          <a href="<%= url %>" target="_blank" rel="noopener" class="flex flex-row items-center gap-3"><img src="<%= relative_url icon %>" class="w-6 h-6 object-cover" alt=""/><%= label %><span class="sr-only"> for <%= @artist["name"] %></span></a>
        <% end %>
      </div>
    <% end %>
    <% if @artist["bio"].present? %><p><%= @artist["bio"] %></p><% end %>
  </div>
</article>
