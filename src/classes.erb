---
layout: default
title: Classes & Workshops
---

<%
  square_classes = site.data.square_classes || []
  pottery_101, workshops = square_classes.partition { |c| c.course? && c.name.match?(/pottery 101/i) }
  workshops = workshops.partition(&:featured).flatten
  page_copy = site.data.classes_page
  banner, intro, course, workshop_copy = page_copy["banner"] || {}, page_copy["intro"], page_copy["pottery_101"], page_copy["workshops"]
%>

<section class="py-20 px-12 bg-indigo-900 hero bg-fixed" style="background-image: url(<%= relative_url('/images/hero-molten.png') %>)">
  <div class="space-y-2 mb-10">
    <h2 class="text-lime-500"><%= banner["heading"].presence || "Classes! Workshops!" %></h2>
  </div>
  <% if banner["tagline"].present? %><h5 class="text-brown-100"><%= banner["tagline"] %></h5><% end %>
</section>

<section class="bg-brown-100 flex flex-col lg:flex-row gap-10">
  <img src="<%= relative_url '/images/lime-sculpt.png' %>" alt="" class="-mt-10 h-full w-full max-w-[330px] object-cover ml-10 z-1"/>
  <div class="container mx-auto pb-30 pt-10 px-12 ">
    <h4 class="mb-10 text-lime-800"><%= intro["heading"] %></h4>
    <% intro_paragraphs = paragraphs(intro["body"]) %>
    <% intro_paragraphs.each_with_index do |paragraph, i| %>
      <p class="<%= 'mb-4' unless i == intro_paragraphs.length - 1 %>"><%= paragraph %><% if i == intro_paragraphs.length - 1 && intro["highlight"].present? %> <span class="text-lime-800"><%= intro["highlight"] %></span><% end %></p>
    <% end %>
  </div>
  <img src="<%= relative_url '/images/indigo-wheels.jpg' %>" alt="" class="w-auto h-full object-cover" />
</section>
<div class="triangle-bottomleft bg-transparent -mt-20"></div>
<section class="bg-coal-1000 py-20 px-12 ">
  <div class="container mx-auto flex flex-col md:flex-row gap-20">
    <div class="w-full md:w-2/3">
      <h2 class="text-lime-500 mb-10"><%= course["heading"] %></h2>
      <h5 class="text-lime-500 mb-10"><%= course["lead"] %></h5>
      <% course_paragraphs = paragraphs(course["body"]) %>
      <% course_paragraphs.each_with_index do |paragraph, i| %>
        <p class="text-coal-0 <%= 'mb-4' unless i == course_paragraphs.length - 1 %>"><%= paragraph %></p>
      <% end %>
    </div>
    <%= render Shared::Disciplines.new(items: course["disciplines"], layout: :column) %>
  </div>
</section>
<div class="triangle-topright bg-coal-1100"></div>

<section class="py-20 bg-coal-1100 px-12">
  <div class="container mx-auto">
    <h2 class="text-lime-500 mb-10 text-center"><%= course["schedule_heading"] %></h2>


    <div class="flex flex-col md:flex-row gap-10">

      <%# Pottery 101 sessions from Square, grouped by night %>
      <div class="w-full">
        <% if pottery_101.empty? %>
          <p class="text-coal-0 mb-10"><%= course["empty_schedule"] %></p>
        <% end %>
        <% pottery_101.group_by(&:weekday).each do |weekday, sessions| %>
        <div class="w-full mb-10">
          <h3 class="font-display text-lime-500 mb-4 tracking-wider"><%= weekday || "To Be Scheduled" %><%= " Night" if weekday %></h3>
          <ul class="space-y-2">
            <% sessions.each do |session| %>
            <%= render Shared::Class.new(
              dates: session.date_range,
              start_time: session.start_time,
              end_time: session.end_time,
              cost: session.price,
              class_day: session.weekday,
              link: session.url) %>
            <% end %>
          </ul>
        </div>
        <% end %>

        <% if course["cancellation_policy"].present? %>
        <div class="flex flex-col md:flex-row text-lime-500 gap-10">
          <h6 class="">Cancellation Policy:</h6>
          <p class=""><%= course["cancellation_policy"] %></p>
        </div>
        <% end %>

      </div>


      <aside class="w-full max-w-xs flex flex-col justify-between h-full">
        <ul class="space-y-4 p-6" style="list-style-image: url(<%= relative_url '/images/icons/lime-disc.svg' %>)">
          <h6 class="text-lime-700"><%= course["includes_heading"] %></h6>
          <% Array(course["includes"]).each do |item| %>
            <li class="pl-3">
              <p class="text-lg text-coal-0 mb-1 tracking-wider font-medium"><%= item["title"] %></p>
              <% if item["note"].present? %><p class="text-md text-coal-100"><%= item["note"] %></p><% end %>
            </li>
          <% end %>
        </ul>
        <div class="space-y-5">
          <% Array(course["warnings"]).each do |warning| %>
            <div class="bg-brown-950/60 backdrop-blur-md border border-brown-900 p-6 rounded-md">
              <div class="flex flex-col md:flex-row justify-between items-center w-full mb-3">
                <h6 class="text-red-50 uppercase tracking-wider">Warning</h6>
                <img src="<%= relative_url "/images/icons/#{warning["icon"] == 'finger-nails' ? 'finger-nails' : 'messy'}.svg" %>" alt="" class="w-14 h-14 object-cover" />
              </div>
              <p class="text-brown-300 mb-3"><%= warning["text"] %></p>
              <% if warning["note"].present? %><p class="text-brown-300"><%= warning["note"] %></p><% end %>
            </div>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="py-20 bg-indigo-950 px-12 text-coal-0  bg-fixed" style="background-image: url(<%= relative_url '/images/bg-kilnshelves-lg.jpg' %>)">
  <div class="container mx-auto flex flex-col md:flex-row justify-between">
    <div class="">
      <h2 class="text-lime-500 mb-10"><%= workshop_copy["heading"] %></h2>
      <h5 class="mb-6 !leading-10"><%= workshop_copy["lead"] %></h5>
      <% workshop_paragraphs = paragraphs(workshop_copy["body"]) %>
      <% workshop_paragraphs.each_with_index do |paragraph, i| %>
        <p class="<%= 'mb-4' unless i == workshop_paragraphs.length - 1 %>"><%= paragraph %></p>
      <% end %>
    </div>
    <aside class="pl-0 md:pl-10">
      <ul class="space-y-4 p-6" style="list-style-image: url(<%= relative_url '/images/icons/lime-disc.svg' %>)">
        <h6 class="text-lime-700"><%= workshop_copy["includes_heading"] %></h6>
        <% Array(workshop_copy["includes"]).each do |item| %>
          <li class="pl-3"><%= item %></li>
        <% end %>
      </ul>
    </aside>
  </div>
  <% if workshops.empty? && workshop_copy["empty"].present? %>
    <p class="container mx-auto mt-10"><%= workshop_copy["empty"] %> <a href="<%= relative_url '/contact#newsletter' %>" class="underline text-lime-500">Join the email list</a></p>
  <% end %>
  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 container mx-auto">
      <% workshops.each do |workshop| %>
        <%= render Shared::Workshop.new(
          image_src: workshop.image || "/images/example-workshop.jpg",
          alt_text: workshop.alt_text.to_s,
          title: workshop.name,
          description: workshop.summary,
          start_date: workshop.start_date&.strftime("%a, %b %-d"),
          end_date: (workshop.end_date&.strftime("%a, %b %-d") if workshop.multi_day?),
          start_time: workshop.start_time,
          end_time: workshop.end_time,
          cost: workshop.price,
          message: "Email me when another is scheduled",
          email: site.data.site_metadata.email,
          link: workshop.url
          ) %>
      <% end %>
    </ul>
</section>

<% if site.data.site_metadata.gift_card_url.present? %>
<section class="bg-lime-300 border-b-10 border-lime-500 py-16 px-8 md:px-12">
  <div class="container mx-auto flex flex-col md:flex-row md:items-center justify-between gap-8">
    <div>
      <h2 class="text-lime-800 mb-4">Give the gift of clay</h2>
      <p>Treat someone to a class or workshop at the shed.</p>
    </div>
    <a href="<%= site.data.site_metadata.gift_card_url %>" target="_blank" rel="noopener" class="btn btn-primary">Buy a gift card</a>
  </div>
</section>
<% end %>
