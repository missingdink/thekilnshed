<footer class="bg-brown-950 text-coal-0 p-12">
  <div class="flex flex-col md:flex-row justify-between items-center">
    <div class="">
      <img src="<%= relative_url '/images/theKilnShed.svg' %>" class="" alt="The logo that reads The Kiln Shed with a handwritten feel"/>
      <% social = (site.data.site_metadata.social || {}).to_h.select { |_, url| url.present? } %>
      <% if social.any? %>
        <div class="flex flex-row gap-4 p-6">
          <% social.each do |network, url| %>
            <a href="<%= url %>" target="_blank" rel="noopener" aria-label="The Kiln Shed on <%= { "instagram" => "Instagram", "facebook" => "Facebook", "youtube" => "YouTube" }.fetch(network.to_s, network.to_s.titleize) %>"><img src="<%= relative_url "/images/icons/#{network}.svg" %>" class="w-6 h-6 object-fit" alt=""/></a>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="text-lime-500 text-left md:text-right flex flex-col">
      <a href="tel:<%= site.data.site_metadata.phone %>"><%= site.data.site_metadata.phone %></a>
      <a href="mailto:<%= site.data.site_metadata.email %>" class="text-lime-500"><%= site.data.site_metadata.email %></a>
      <p><%= site.data.site_metadata.address %></p>
    </div>
  </div>
</footer>