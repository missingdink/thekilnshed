---
layout: default
title: Kilns
---
<%
  kilns_page = site.data.kilns
  intro, calendar = kilns_page.intro, kilns_page.calendar
  kilns = Array(kilns_page.kilns)
%>
<% banner = kilns_page["banner"] || {} %>
<section class="py-20 px-12 bg-red-900 hero bg-fixed" style="background-image: url(<%= relative_url('/images/hero-bubble.jpg') %>)">
  <div class="space-y-2 mb-10">
    <h2 class="text-lime-500"><%= banner["heading"].presence || "Kilns" %></h2>
  </div>
</section>

<div class="triangle-bottomright bg-transparent border-b-red-600 -mt-[50px]"></div>
<section class="bg-red-600 px-12 py-20 flex flex-col md:flex-row gap-10">
  <% if intro && show_content?(intro) %>
    <div class="md:max-w-xs">
      <%= render Shared::ReviewFlag.new(item: intro) %>
      <h3 class="text-coal-0 mb-4"><%= intro.heading %></h3>
      <p class="text-coal-0"><%= intro.body %></p>
    </div>
  <% end %>
  <ul class="flex flex-col md:flex-row w-full gap-4">
    <% kilns.each do |kiln| %>
      <li class="w-full bg-coal-0/80 p-5">
        <%= render Shared::ReviewFlag.new(item: kiln) %>
        <% if kiln.image.present? %>
          <img src="<%= relative_url kiln.image %>" alt="<%= kiln.image_alt %>" class="mb-5" />
        <% end %>
        <h4 class="mb-4 uppercase !font-black"><%= kiln.name %></h4>
        <h6 class="mb-2 text-red-500"><%= kiln.firing %></h6>
        <p class="mb-3 uppercase"><%= kiln.temperature %></p>
        <% if show_content?(kiln) %>
          <p class=""><%= kiln.description %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
<div class="triangle-topleft bg-red-900 border-t-red-600"></div>

<section class="bg-red-900 w-full py-20 px-12 ">
  <div class="container mx-auto flex flex-col md:flex-row gap-10 relative">
    <div class="relative">
      <h3 class="w-fit text-lime-400 mb-10"><%= calendar&.heading.presence || "Kiln Firing Calendar" %></h3>
      <p class="text-lime-100"><%= calendar&.body %></p>
      <a href="<%= relative_url '/contact?topic=kilns' %>" class="btn btn-secondary mt-8">Request a firing</a>
    </div>
    <img src="<%= relative_url '/images/brown-jug.png' %>" alt="" class="absolute w-[450px] -left-50 -bottom-50" />
    <iframe src="https://calendar.google.com/calendar/embed?height=600&wkst=1&ctz=America%2FChicago&showPrint=0&src=Y180NmIwMmM5NjA4OTc2MTA1MjdlZTEzMDFlZmRlN2Y5MzZjNjQzOTBjMDI0NGZmNzU4ODI0ZTZiMmI4N2NlZmM1QGdyb3VwLmNhbGVuZGFyLmdvb2dsZS5jb20&color=%238e24aa" style="" width="100%" height="700px" frameborder="0" scrolling="no" class="bg-lime-500"></iframe>
  </div>
</section>


<section class="bg-brown-100 py-20 px-12">
  
  <ul class="container mx-auto space-y-2 p-20">
    <h2 class="text-red-600 mb-10"><%= kilns_page.dig("faq", "heading").presence || "Kiln & Firing FAQs" %></h2>
      <% site.data.faqs.each_with_index do |(slug, faq), i| %>
        <%= render Shared::Faq.new(
          question:    faq.question,
          answer:      faq.answer,
          button_text: faq.button_text,
          link:        faq.link
        ) %>
      <% end %>
    </ul>

</section>