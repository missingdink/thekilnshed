<!DOCTYPE html>
<html lang="<%= site.data.site_metadata.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= resource.data.title || site.data.site_metadata.title %></title>
  <meta name="description" content="<%= site.data.site_metadata.description %>">
  <link rel="stylesheet" href="<%= asset_path :css %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
  <script src="<%= asset_path :js %>" defer></script>
</head>


<body class="bg-brown-25 min-h-screen flex flex-col">
  <%= render "shared/nav" %>

  <main class="flex-1 flex flex-col">
    <%= yield %>
  </main>
  
  <%= render "shared/footer" %>
</body>

</html>
