#!/usr/bin/env bash
# Verify Cloudflare account details and Workers subdomain.
# Useful when picking __GITHUB_ORG_SLUG__ for a new oauth-worker deploy
# or troubleshooting CLOUDFLARE_API_TOKEN scope.
#
# Required env: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID

set -euo pipefail

: "${CLOUDFLARE_API_TOKEN:?must be set}"
: "${CLOUDFLARE_ACCOUNT_ID:?must be set}"

api() {
  curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" "$@"
}

echo "== Account details =="
api "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID" \
  | jq '.result | { id, name, type }'

echo ""
echo "== Workers subdomain =="
api "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/subdomain" \
  | jq '.result'

echo ""
echo "== Existing workers (avoid name collisions) =="
api "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/workers/scripts" \
  | jq -r '.result[].id // empty' \
  | sort \
  | sed 's/^/  - /'

echo ""
echo "== Existing Pages projects =="
api "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/pages/projects" \
  | jq -r '.result[].name // empty' \
  | sort \
  | sed 's/^/  - /'
